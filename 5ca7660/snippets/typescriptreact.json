  "React Router Parent-route Component": {
    "prefix": "rrp",
    "body": [
      "// react",
      "import { Route, Outlet } from \"react-router-dom\";",
      "// style",
      "import { Container, useTheme } from \"@mui/material\";",
      "// components",
      "// import XYZ from \"./XYZ\";",
      "",
      "/** $8 */",
      "const $1Router: React.FC = () => {",
      "  return (",
      "    <Route path=\"/\" element={<ViewLayout />}>",
      "      {/* <Route index element={<XYZ />} /> */}",
      "      <Route path=\"*\" element={<NotFound />} />",
      "    </Route>",
      "  );",
      "};",
      "",
      "export default $1Router;",
      "",
      "/** Top-level display settings for all nested routes */",
      "function ViewLayout() {",
      "  const theme = useTheme();",
      "",
      "  return (",
      "    <Container",
      "      sx={{",
      "        flex: 1,",
      "        overflow: \"scroll\",",
      "        alignItems: \"center\",",
      "        display: \"flex\",",
      "        flexFlow: \"column\",",
      "        \"& > div\": {",
      "          height: \"100%\",",
      "          minHeight: \"100%\",",
      "          width: \"100%\",",
      "          maxWidth: { xs: \"100%\", lg: theme.breakpoints.values.lg },",
      "        },",
      "        background: \"grey\",",
      "      }}",
      "    >",
      "      <Outlet />",
      "    </Container>",
      "  );",
      "}",
      "",
      "/** Simple view for unmatched route path patterns */",
      "function NotFound() {",
      "  return <Container className=\"not-found\">Error: Route Not Found</Container>;",
      "}"
    ],
    "description": "React Router Parent-route Component"
  },
