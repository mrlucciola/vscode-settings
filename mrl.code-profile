{"name":"mrl","settings":"{\"settings\":\"{\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////// LANGUAGE SETTINGS /////////////////////////////\\n  \\\"[csharp]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"csharpier.csharpier-vscode\\\",\\n    \\\"editor.tabSize\\\": 4,\\n    \\\"editor.indentSize\\\": 4,\\n    \\\"editor.acceptSuggestionOnCommitCharacter\\\": false,\\n    \\\"editor.acceptSuggestionOnEnter\\\": \\\"on\\\",\\n    \\\"editor.semanticHighlighting.enabled\\\": \\\"configuredByTheme\\\"\\n  },\\n  \\\"csharp.debug.logging.moduleLoad\\\": false,\\n  \\\"csharp.debug.console\\\": \\\"integratedTerminal\\\",\\n  \\\"csharp.format.enable\\\": true,\\n  \\\"csharp.experimental.debug.hotReload\\\": true,\\n  \\\"dotnetAcquisitionExtension.existingDotnetPath\\\": [\\\"/usr/local/share/dotnet/dotnet\\\"],\\n  \\\"dotnet.codeLens.enableReferencesCodeLens\\\": false,\\n  \\\"[css]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[dockercompose]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[dockerfile]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-azuretools.vscode-docker\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[dotenv]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[gitignore]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\"\\n  },\\n  \\\"[npmignore]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\"\\n  },\\n  \\\"[html]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.html-language-features\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"html.format.maxPreserveNewLines\\\": 1,\\n  \\\"[ignore]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\"\\n  },\\n  \\\"[ini]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"lkrms.inifmt\\\"\\n  },\\n  \\\"[javascript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[javascriptreact]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[json]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[jsonc]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[markdown]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 3\\n  },\\n  \\\"markdown.editor.pasteUrlAsFormattedLink.enabled\\\": \\\"smart\\\",\\n  \\\"markdown-mermaid.languages\\\": [\\\"mermaid\\\"],\\n  \\\"markdown.preview.scrollPreviewWithEditor\\\": false,\\n  \\\"markdown.preview.scrollEditorWithPreview\\\": false,\\n  \\\"markdown.updateLinksOnFileMove.enabled\\\": \\\"never\\\",\\n  \\\"[mermaid]\\\": {\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[plaintext]\\\": {\\n    \\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n    \\\"editor.unicodeHighlight.invisibleCharacters\\\": false\\n  },\\n  \\\"[prisma]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"Prisma.prisma\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[python]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-python.black-formatter\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"python.formatting.provider\\\": \\\"black\\\",\\n  \\\"jupyter.askForKernelRestart\\\": false,\\n  \\\"[rust]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"rust-lang.rust-analyzer\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[shellscript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"shellformat.path\\\": \\\"/Users/matthias/go/bin/shfmt\\\",\\n  \\\"[snippets]\\\": {\\n    // \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[solidity]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"NomicFoundation.hardhat-solidity\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[sql]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"mtxr.sqltools\\\"\\n  },\\n  \\\"[toml]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"tamasfe.even-better-toml\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[typescript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"typescript.inlayHints.enumMemberValues.enabled\\\": true,\\n  \\\"npm-intellisense.importQuotes\\\": \\\"\\\\\\\"\\\",\\n  \\\"typescript.preferences.importModuleSpecifier\\\": \\\"relative\\\",\\n  \\\"typescript.preferences.includePackageJsonAutoImports\\\": \\\"on\\\",\\n  \\\"typescript.preferences.preferTypeOnlyAutoImports\\\": true,\\n  \\\"[typescriptreact]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[yaml]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  ///////////////////////////// LANGUAGE SETTINGS /////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  ////////////////////////////////// EDITOR ///////////////////////////////////\\n  // Editor: Diff Editor\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n  // Editor: Editor\\n  \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n  \\\"editor.autoClosingBrackets\\\": \\\"beforeWhitespace\\\",\\n  \\\"editor.autoClosingDelete\\\": \\\"always\\\",\\n  \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.glyphMargin\\\": true,\\n  \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\n  \\\"editor.inlineSuggest.enabled\\\": true,\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.minimap.maxColumn\\\": 40,\\n  \\\"editor.minimap.renderCharacters\\\": false,\\n  \\\"editor.minimap.size\\\": \\\"fit\\\",\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"editor.tabCompletion\\\": \\\"on\\\",\\n  \\\"editor.tabSize\\\": 2,\\n  \\\"editor.wordWrapColumn\\\": 100,\\n  // Editor: Files\\n  \\\"files.associations\\\": {\\n    \\\"*.rest\\\": \\\"http\\\",\\n    \\\"*.yaml-tmLanguage\\\": \\\"yaml\\\",\\n    \\\"*.mmd\\\": \\\"mermaid\\\",\\n    \\\"*.mermaid\\\": \\\"mermaid\\\",\\n    \\\".gitignore\\\": \\\"ignore\\\",\\n    \\\".npmignore\\\": \\\"ignore\\\",\\n    \\\"pre-push\\\": \\\"shellscript\\\",\\n    \\\"prepare-commit-msg\\\": \\\"shellscript\\\",\\n    \\\"commit-msg\\\": \\\"shellscript\\\",\\n    \\\"pre-commit\\\": \\\"shellscript\\\",\\n    \\\"post-commit\\\": \\\"shellscript\\\",\\n    \\\"applypatch-msg\\\": \\\"shellscript\\\",\\n    \\\"pre-applypatch\\\": \\\"shellscript\\\",\\n    \\\"post-applypatch\\\": \\\"shellscript\\\",\\n    \\\"pre-rebase\\\": \\\"shellscript\\\",\\n    \\\"post-rewrite\\\": \\\"shellscript\\\",\\n    \\\"post-checkout\\\": \\\"shellscript\\\",\\n    \\\"post-merge\\\": \\\"shellscript\\\",\\n    \\\"pre-merge-commit\\\": \\\"shellscript\\\",\\n    \\\"pre-receive\\\": \\\"shellscript\\\",\\n    \\\"post-receive\\\": \\\"shellscript\\\",\\n    \\\"proc-receive\\\": \\\"shellscript\\\",\\n    \\\"sendemail-validate\\\": \\\"shellscript\\\",\\n    \\\"update\\\": \\\"shellscript\\\",\\n    \\\"post-update\\\": \\\"shellscript\\\",\\n    \\\"pre-auto-gc\\\": \\\"shellscript\\\",\\n    \\\"push-to-checkout\\\": \\\"shellscript\\\",\\n    \\\"reference-transaction\\\": \\\"shellscript\\\",\\n    \\\"fsmonitor-watchman\\\": \\\"shellscript\\\",\\n    \\\"*.zsh\\\": \\\"shellscript\\\",\\n    \\\"*.sh\\\": \\\"shellscript\\\",\\n    \\\"*.bash\\\": \\\"shellscript\\\"\\n  },\\n  // Editor: Search\\n  \\\"search.exclude\\\": {\\n    \\\"**/*tsconfig.tsbuildinfo\\\": true,\\n    \\\"**/dist\\\": true,\\n    \\\"**/package-lock.json\\\": true,\\n    \\\"**/yarn.lock\\\": true,\\n    \\\"**/node_modules\\\": true,\\n    \\\"**/bun.lockb\\\": true,\\n    \\\"**/*.cpy\\\": true,\\n    \\\"**/*.pyc\\\": true\\n  },\\n  // Editor: Window\\n  \\\"window.commandCenter\\\": false,\\n  \\\"window.zoomLevel\\\": -1,\\n  \\\"window.autoDetectColorScheme\\\": true,\\n  // performance\\n  \\\"keyboard.touchbar.enabled\\\": false,\\n  \\\"terminal.integrated.gpuAcceleration\\\": \\\"on\\\",\\n  // Editor Layout: General\\n  \\\"workbench.activityBar.location\\\": \\\"top\\\",\\n  \\\"workbench.layoutControl.enabled\\\": false,\\n  // Editor Layout: Gutter\\n  \\\"scm.diffDecorationsGutterWidth\\\": 5,\\n  \\\"scm.showIncomingChanges\\\": \\\"never\\\",\\n  \\\"scm.showOutgoingChanges\\\": \\\"never\\\",\\n  ////////////////////////////////// EDITOR ///////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  //////////////////////////////////// GIT ////////////////////////////////////\\n  \\\"git.alwaysSignOff\\\": true,\\n  \\\"git.enableCommitSigning\\\": true,\\n  \\\"git.openRepositoryInParentFolders\\\": \\\"always\\\",\\n  \\\"git.optimisticUpdate\\\": false,\\n  \\\"git.suggestSmartCommit\\\": false,\\n  // \\\"Gitlens\\\" Extendsion\\n  \\\"gitlens.views.branches.branches.layout\\\": \\\"list\\\",\\n  \\\"gitlens.views.commits.pullRequests.enabled\\\": false,\\n  \\\"gitlens.views.formats.stashes.description\\\": \\\"${stashOnRef, } ${message} - ${authorDate} - ${tips}\\\",\\n  \\\"gitlens.views.formats.stashes.label\\\": \\\"${message} ${authorDate}\\\",\\n  \\\"gitlens.views.scm.grouped.views\\\": {\\n    \\\"commits\\\": false,\\n    \\\"branches\\\": false,\\n    \\\"remotes\\\": false,\\n    \\\"stashes\\\": false,\\n    \\\"tags\\\": false,\\n    \\\"worktrees\\\": false,\\n    \\\"contributors\\\": false,\\n    \\\"repositories\\\": false,\\n    \\\"searchAndCompare\\\": false,\\n    \\\"launchpad\\\": false\\n  },\\n  //////////////////////////////////// GIT ////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  ////////////////////////////////// GITHUB ///////////////////////////////////\\n  // \\\"GitHub CoPilot\\\" Extension\\n  \\\"github.copilot.enable\\\": {\\n    \\\"*\\\": true,\\n    \\\"plaintext\\\": false,\\n    \\\"markdown\\\": false,\\n    \\\"scminput\\\": false\\n  },\\n  \\\"github.copilot.advanced\\\": {},\\n  // \\\"GitHub Pull-Requests\\\" Extension\\n  \\\"githubPullRequests.defaultMergeMethod\\\": \\\"squash\\\",\\n  \\\"githubPullRequests.showPullRequestNumberInTree\\\": true,\\n  \\\"githubPullRequests.pullBranch\\\": \\\"never\\\",\\n  \\\"githubPullRequests.remotes\\\": [\\\"origin\\\"],\\n  \\\"githubPullRequests.assignCreated\\\": \\\"${user}\\\",\\n  \\\"githubPullRequests.pushBranch\\\": \\\"always\\\",\\n  \\\"githubPullRequests.quickDiff\\\": true,\\n  // \\\"GitHub Issues\\\" Extension\\n  \\\"githubIssues.queries\\\": [\\n    {\\n      \\\"label\\\": \\\"My Issues\\\",\\n      \\\"query\\\": \\\"author:${user} state:open repo:${owner}/${repository} sort:created-desc\\\"\\n    },\\n    {\\n      \\\"label\\\": \\\"Recent Issues\\\",\\n      \\\"query\\\": \\\"state:open repo:${owner}/${repository} sort:updated-desc\\\"\\n    }\\n  ],\\n  \\\"githubIssues.createInsertFormat\\\": \\\"url\\\",\\n  \\\"githubIssues.issueBranchTitle\\\": \\\"${issueNumber}-${sanitizedIssueTitle}\\\",\\n  \\\"githubIssues.createIssueTriggers\\\": [\\\"TODO\\\", \\\"todo\\\", \\\"BUG\\\", \\\"FIXME\\\", \\\"ISSUE\\\", \\\"@todo\\\"],\\n  ////////////////////////////////// GITHUB ///////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////// DOCKER/KUBERNETES /////////////////////////////\\n  \\\"vs-kubernetes\\\": {\\n    \\\"vscode-kubernetes.helm-path-mac\\\": \\\"/Users/matthias/.vs-kubernetes/tools/helm/darwin-amd64/helm\\\",\\n    \\\"vscode-kubernetes.minikube-path-mac\\\": \\\"/Users/matthias/.vs-kubernetes/tools/minikube/darwin-amd64/minikube\\\"\\n  },\\n  ///////////////////////////// DOCKER/KUBERNETES /////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////////// TELEMETRY /////////////////////////////////\\n  \\\"dotnetAcquisitionExtension.enableTelemetry\\\": false,\\n  \\\"extensions.autoCheckUpdates\\\": false,\\n  \\\"extensions.autoUpdate\\\": false,\\n  \\\"extensions.webWorker\\\": false,\\n  \\\"gitlens.telemetry.enabled\\\": false,\\n  \\\"hardhat.telemetry\\\": false,\\n  \\\"javascript.suggestionActions.enabled\\\": false,\\n  \\\"php.suggest.basic\\\": false,\\n  \\\"redhat.telemetry.enabled\\\": false,\\n  \\\"rest-client.enableTelemetry\\\": false,\\n  \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n  \\\"solidity.telemetry\\\": false,\\n  \\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\n  \\\"typescript.suggestionActions.enabled\\\": false,\\n  \\\"typescript.surveys.enabled\\\": false,\\n  \\\"workbench.enableExperiments\\\": false,\\n  \\\"workbench.settings.enableNaturalLanguageSearch\\\": false,\\n  ///////////////////////////////// TELEMETRY /////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  //////////////////////////////////// EVM ////////////////////////////////////\\n  //////////////////////////////////// EVM ////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n  //////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////////// VIM/NEOVIM /////////////////////////////////\\n  \\\"extensions.experimental.affinity\\\": {\\n    \\\"asvetliakov.vscode-neovim\\\": 1\\n  },\\n  ///////////////////////////////// VIM/NEOVIM /////////////////////////////////\\n  //////////////////////////////////////////////////////////////////////////////\\n  // bookmarks/highlights\\n  \\\"todohighlight.include\\\": [\\n    \\\"**/*.ts\\\",\\n    \\\"**/*.tsx\\\",\\n    \\\"**/*.md\\\",\\n    \\\"**/*.rs\\\",\\n    \\\"**/*.mmd\\\",\\n    \\\"**/*.mermaid\\\",\\n    \\\"**/*.js\\\",\\n    \\\"**/*.jsx\\\",\\n    \\\"**/*.json\\\",\\n    \\\"**/*.py\\\",\\n    \\\"**/*.ipynb\\\"\\n  ],\\n  \\\"inline-bookmarks.default.words.red\\\": \\\"@fix[\\\\\\\\s],@delete[\\\\\\\\s]\\\",\\n  \\\"inline-bookmarks.default.words.blue\\\": \\\"@note[\\\\\\\\s]\\\",\\n  \\\"inline-bookmarks.default.words.purple\\\": \\\"@todo[\\\\\\\\s]\\\",\\n  \\\"inline-bookmarks.default.words.green\\\": \\\"\\\",\\n  \\\"inline-bookmarks.search.excludes\\\": [\\n    \\\"**/node_modules/**\\\",\\n    \\\"**/dist\\\",\\n    \\\"**/build/**\\\",\\n    \\\"**/out/**\\\",\\n    \\\"**/_output/**\\\",\\n    \\\"**/*.min.*\\\",\\n    \\\"**/*.map\\\",\\n    \\\"**/bower_components/**\\\",\\n    \\\"**/.next/**\\\",\\n    \\\"**/.git/**\\\",\\n    \\\"**/.github/**\\\",\\n    \\\"**/.vscode/**\\\",\\n    \\\"**/.vscode-test/**\\\"\\n  ],\\n  \\\"prettier.printWidth\\\": 100,\\n  \\\"prettier.htmlWhitespaceSensitivity\\\": \\\"strict\\\",\\n  \\\"python.experiments.enabled\\\": false,\\n  \\\"python.experiments.optInto\\\": [],\\n  \\\"notebook.defaultFormatter\\\": \\\"ms-python.black-formatter\\\"\\n}\\n\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaultsauto[]\\n[\\n  {\\n    \\\"key\\\": \\\"shift+alt+4\\\",\\n    \\\"command\\\": \\\"issue.startWorkingBranchDescriptiveTitle\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+2\\\",\\n    \\\"command\\\": \\\"issue.createIssue\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+3\\\",\\n    \\\"command\\\": \\\"pr.pushAndCreate\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+z\\\",\\n    \\\"command\\\": \\\"issues:github.focus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+1\\\",\\n    \\\"command\\\": \\\"issue.createIssueFromSelection\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+w\\\",\\n    \\\"command\\\": \\\"git.checkout\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+e\\\",\\n    \\\"command\\\": \\\"git.fetch\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+c\\\",\\n    \\\"command\\\": \\\"issue.statusBar\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+x\\\",\\n    \\\"command\\\": \\\"pr.refreshChanges\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+x\\\",\\n    \\\"command\\\": \\\"issue.refresh\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+m\\\",\\n    \\\"command\\\": \\\"pr.merge\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+\\\\\\\\\\\",\\n    \\\"command\\\": \\\"editor.action.selectToBracket\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+/\\\",\\n    \\\"command\\\": \\\"editor.action.goToImplementation\\\",\\n    \\\"when\\\": \\\"editorHasImplementationProvider && editorTextFocus && !isInEmbeddedEditor\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"search.action.cancel\\\",\\n    \\\"when\\\": \\\" searchViewletVisible && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"search.action.cancel\\\",\\n    \\\"when\\\": \\\"listFocus && searchViewletVisible && !inputFocus && searchState != '0'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"closeReferenceSearch\\\",\\n    \\\"when\\\": \\\"inReferenceSearchEditor && !config.editor.stablePeek\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"closeReferenceSearch\\\",\\n    \\\"when\\\": \\\"referenceSearchVisible && !config.editor.stablePeek\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"search.action.cancel\\\",\\n    \\\"when\\\": \\\"listFocus && searchViewletVisible && !inputFocus && searchState != '0'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"removeSecondaryCursors\\\",\\n    \\\"when\\\": \\\"editorHasMultipleSelections && textInputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"closeFindWidget\\\",\\n    \\\"when\\\": \\\"editorFocus && findWidgetVisible && !isComposing\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+=\\\",\\n    \\\"command\\\": \\\"-workbench.action.zoomIn\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+=\\\",\\n    \\\"command\\\": \\\"workbench.action.debug.stepOver\\\",\\n    \\\"when\\\": \\\"debugState == 'stopped'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"f10\\\",\\n    \\\"command\\\": \\\"-workbench.action.debug.stepOver\\\",\\n    \\\"when\\\": \\\"debugState == 'stopped'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+0\\\",\\n    \\\"command\\\": \\\"editor.debug.action.toggleBreakpoint\\\",\\n    \\\"when\\\": \\\"debuggersAvailable && disassemblyViewFocus || debuggersAvailable && editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+cmd+=\\\",\\n    \\\"command\\\": \\\"workbench.action.debug.stepInto\\\",\\n    \\\"when\\\": \\\"debugState != 'inactive'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+cmd+-\\\",\\n    \\\"command\\\": \\\"workbench.action.debug.stepOut\\\",\\n    \\\"when\\\": \\\"debugState == 'stopped'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"-workbench.view.debug\\\",\\n    \\\"when\\\": \\\"viewContainer.workbench.view.debug.enabled\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"workbench.view.scm\\\",\\n    \\\"when\\\": \\\"workbench.scm.active && !gitlens:disabled && config.gitlens.keymap == 'chorded'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"workbench.view.scm\\\",\\n    \\\"when\\\": \\\"workbench.scm.active\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+h\\\",\\n    \\\"command\\\": \\\"gitlens.views.fileHistory.focus\\\"\\n  }\\n]\",\"platform\":1}","snippets":"{\"snippets\":{\"csharp.json\":\"// snippet-generator.app\\n{\\n\\t// Place your snippets for csharp here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"Interpolated Multiline Console Log\\\": {\\n\\t\\t\\\"prefix\\\": \\\"llog\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"Console.WriteLine(@$\\\\\\\"$1\\\\\\\");\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Interpolated Multiline Console Log\\\"\\n\\t},\\n\\t\\\"Interpolated Multiline Console Log With JSON\\\": {\\n\\t\\t\\\"prefix\\\": \\\"lljson\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"Console.WriteLine(@$\\\\\\\"{JsonConvert.SerializeObject($1, Formatting.Indented)}\\\\\\\");\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Interpolated Multiline Console Log With JSON\\\"\\n\\t}\\n}\",\"rust.json\":\"{\\n  ///////////////////////////////////////////////////\\n  ///////////////////// PRINT ///////////////////////\\n  \\\"Simple string print statement\\\": {\\n    \\\"prefix\\\": \\\"pls\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1\\\\\\\");\\\", \\\"$0\\\"],\\n    \\\"description\\\": \\\"Common print statement without input\\\"\\n  },\\n  \\\"Print statement w/ primative input\\\": {\\n    \\\"prefix\\\": \\\"plp\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{}$2\\\\\\\", $3);$0\\\"],\\n    \\\"description\\\": \\\"Basic print statement with input\\\"\\n  },\\n  \\\"Print interpolated w/ primative input\\\": {\\n    \\\"prefix\\\": \\\"pli\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{$2}$3\\\\\\\");$0\\\"],\\n    \\\"description\\\": \\\"Interpolated print statement with input\\\"\\n  },\\n  \\\"Print statement w/ non-primative input\\\": {\\n    \\\"prefix\\\": \\\"plo\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{:?}$2\\\\\\\", $3);$0\\\"],\\n    \\\"description\\\": \\\"Basic print statement with non-primative input\\\"\\n  },\\n  \\\"Print interpolated w/ non-primative input\\\": {\\n    \\\"prefix\\\": \\\"ploi\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{$2:?}$3\\\\\\\");$0\\\"],\\n    \\\"description\\\": \\\"Interpolated print statement with non-primative input\\\"\\n  },\\n  ///////////////////// PRINT ///////////////////////\\n  ///////////////////////////////////////////////////\\n\\n  ///////////////////////////////////////////////////\\n  ////////////////////// LET ////////////////////////\\n  \\\"Let statement\\\": {\\n    \\\"prefix\\\": \\\"llet\\\",\\n    \\\"body\\\": [\\\"let ${2:xyz}$3 = $1;$0\\\"],\\n    \\\"description\\\": \\\"Let statement\\\"\\n  },\\n  ////////////////////// LET ////////////////////////\\n  ///////////////////////////////////////////////////\\n\\n  ///////////////////////////////////////////////////\\n  //////////////////// STRINGS //////////////////////\\n  \\\"`New` string\\\": {\\n    \\\"prefix\\\": \\\"sstrnew\\\",\\n    \\\"body\\\": [\\\"let $2 = String::new();\\\", \\\"$0\\\"],\\n    \\\"description\\\": \\\"`New` string\\\"\\n  },\\n  \\\"`From` string\\\": {\\n    \\\"prefix\\\": \\\"sstrfrom\\\",\\n    \\\"body\\\": [\\\"let $2 = String::from(\\\\\\\"$1\\\\\\\");$0\\\"],\\n    \\\"description\\\": \\\"`From` string\\\"\\n  },\\n  \\\"R-string\\\": {\\n    \\\"prefix\\\": \\\"rstr\\\",\\n    \\\"body\\\": [\\\"let ${1:var_name} = r#\\\\\\\"\\\", \\\"    $2\\\", \\\"\\\\\\\"#;\\\", \\\"$0\\\"],\\n    \\\"description\\\": \\\"R-string\\\"\\n  },\\n  //////////////////// STRINGS //////////////////////\\n  ///////////////////////////////////////////////////\\n\\n  ////////////////////////////////////////////////////\\n  ////////////////////// STRUCT //////////////////////\\n  \\\"Struct with `new`\\\": {\\n    \\\"prefix\\\": \\\"structnew\\\",\\n    \\\"body\\\": [\\n      \\\"struct ${1:struct_name} {$2}\\\",\\n      \\\"\\\",\\n      \\\"impl ${1:struct_name} {\\\",\\n      \\\"    fn new(&self) -> Self {\\\",\\n      \\\"        Self {$3}\\\",\\n      \\\"    }\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Struct with `new`\\\"\\n  },\\n  ////////////////////// STRUCT //////////////////////\\n  ////////////////////////////////////////////////////\\n\\n  ///////////////////////////////////////////////////\\n  /////////////////// FUNCTIONS /////////////////////\\n  \\\"Fxn statement\\\": {\\n    \\\"prefix\\\": \\\"fxn\\\",\\n    \\\"body\\\": [\\\"fn $1($2) {$3}\\\"],\\n    \\\"description\\\": \\\"Fxn statement\\\"\\n  },\\n  \\\"Fxn statement w/ return type\\\": {\\n    \\\"prefix\\\": \\\"fxnr\\\",\\n    \\\"body\\\": [\\\"fn $1($2) -> ${3:()} {$4}\\\"],\\n    \\\"description\\\": \\\"Fxn statement w/ return type\\\"\\n  }\\n  /////////////////// FUNCTIONS /////////////////////\\n  ///////////////////////////////////////////////////\\n}\\n\",\"solidity.json