{"name":"mrl","icon":"zap","settings":"{\"settings\":\"{\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////// LANGUAGE SETTINGS /////////////////////////////\\n  // LANG: C#\\n  \\\"[csharp]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"csharpier.csharpier-vscode\\\",\\n    \\\"editor.tabSize\\\": 4,\\n    \\\"editor.indentSize\\\": 4,\\n    \\\"editor.acceptSuggestionOnCommitCharacter\\\": false,\\n    \\\"editor.acceptSuggestionOnEnter\\\": \\\"on\\\",\\n    \\\"editor.semanticHighlighting.enabled\\\": \\\"configuredByTheme\\\"\\n  },\\n  \\\"csharp.debug.logging.moduleLoad\\\": false,\\n  \\\"csharp.debug.console\\\": \\\"integratedTerminal\\\",\\n  \\\"csharp.format.enable\\\": true,\\n  \\\"csharp.experimental.debug.hotReload\\\": true,\\n  \\\"dotnetAcquisitionExtension.existingDotnetPath\\\": [\\\"/usr/local/share/dotnet/dotnet\\\"],\\n  \\\"dotnet.codeLens.enableReferencesCodeLens\\\": false,\\n\\n  \\\"[css]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[dockercompose]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[dockerfile]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-azuretools.vscode-docker\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[dotenv]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[gitignore]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\"\\n    // \\\"editor.defaultFormatter\\\": \\\"mkhl.shfmt\\\"\\n  },\\n  \\\"[npmignore]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\"\\n  },\\n  \\\"[ignore]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\"\\n  },\\n  \\\"[html]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.html-language-features\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"html.format.maxPreserveNewLines\\\": 1,\\n  \\\"[ini]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"lkrms.inifmt\\\"\\n  },\\n  \\\"[javascript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[javascriptreact]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[json]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[jsonc]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n\\n  // LANG: MARKDOWN\\n  \\\"[markdown]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 3\\n  },\\n  \\\"markdown.editor.pasteUrlAsFormattedLink.enabled\\\": \\\"smart\\\",\\n  \\\"markdown-mermaid.languages\\\": [\\\"mermaid\\\"],\\n  \\\"markdown.preview.scrollPreviewWithEditor\\\": false,\\n  \\\"markdown.preview.scrollEditorWithPreview\\\": false,\\n  \\\"markdown.updateLinksOnFileMove.enabled\\\": \\\"never\\\",\\n  \\\"markdown.updateLinksOnFileMove.include\\\": [\\n    \\\"**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}\\\",\\n    \\\"**/*.{jpg,jpe,jpeg,png,bmp,gif,ico,webp,avif,tiff,svg,mp4,mp3}\\\"\\n  ],\\n\\n  \\\"[mermaid]\\\": {\\n    \\\"editor.tabSize\\\": 4\\n  },\\n\\n  \\\"[plaintext]\\\": {\\n    \\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n    \\\"editor.unicodeHighlight.invisibleCharacters\\\": false\\n  },\\n\\n  // LANG: POWERSHELL\\n  \\\"[powershell]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-vscode.powershell\\\",\\n    \\\"editor.tabSize\\\": 2,\\n    \\\"editor.formatOnSave\\\": false,\\n    \\\"files.trimTrailingWhitespace\\\": true,\\n    \\\"files.trimFinalNewlines\\\": true,\\n    \\\"files.insertFinalNewline\\\": true\\n  },\\n  \\\"powershell.promptToUpdatePowerShell\\\": false,\\n  \\\"powershell.codeFormatting.trimWhitespaceAroundPipe\\\": true,\\n  \\\"powershell.debugging.createTemporaryIntegratedConsole\\\": true,\\n  \\\"powershell.codeFormatting.whitespaceBetweenParameters\\\": true,\\n  \\\"powershell.pester.useLegacyCodeLens\\\": false,\\n  \\\"powershell.integratedConsole.focusConsoleOnExecute\\\": false,\\n  \\\"powershell.codeFormatting.preset\\\": \\\"OTBS\\\",\\n\\n  \\\"[prisma]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"Prisma.prisma\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[python]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n    \\\"editor.tabSize\\\": 4,\\n    \\\"editor.codeActionsOnSave\\\": {\\n      \\\"source.fixAll.ruff\\\": \\\"explicit\\\",\\n      \\\"source.organizeImports.ruff\\\": \\\"explicit\\\"\\n    }\\n  },\\n  // basedpyright — the Pylance-parity feature set\\n  \\\"basedpyright.analysis.typeCheckingMode\\\": \\\"standard\\\",\\n  \\\"basedpyright.analysis.inlayHints.variableTypes\\\": true,\\n  \\\"basedpyright.analysis.inlayHints.functionReturnTypes\\\": true,\\n  \\\"basedpyright.analysis.inlayHints.callArgumentNames\\\": true,\\n  \\\"basedpyright.analysis.inlayHints.genericTypes\\\": false,\\n  \\\"basedpyright.importStrategy\\\": \\\"fromEnvironment\\\",\\n  \\\"basedpyright.disableLanguageServices\\\": false,\\n  // Stop ms-python from starting a server that would fight basedpyright\\n  \\\"python.languageServer\\\": \\\"None\\\",\\n  \\\"python.terminal.activateEnvInCurrentTerminal\\\": true,\\n  \\\"python.experiments.enabled\\\": false,\\n  \\\"python.experiments.optInto\\\": [],\\n  \\\"python.experiments.optOutFrom\\\": [\\\"All\\\"],\\n  \\\"notebook.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n  \\\"jupyter.askForKernelRestart\\\": false,\\n  // \\\"python.analysis.typeCheckingMode\\\": \\\"basic\\\",\\n  // \\\"python.formatting.provider\\\": \\\"black\\\",\\n  // \\\"black-formatter.args\\\": [\\\"--line-length\\\", \\\"120\\\"],\\n\\n  // LANG: RUST\\n  \\\"[rust]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"rust-lang.rust-analyzer\\\",\\n    \\\"editor.tabSize\\\": 4,\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n    \\\"files.autoSaveDelay\\\": 250 // recommended to use 500\\n  },\\n  // solana/anchor specific rust settings:\\n  \\\"rust-analyzer.files.exclude\\\": [\\\"target\\\", \\\".anchor\\\", \\\"test-ledger\\\"],\\n  \\\"files.watcherExclude\\\": {\\n    \\\"**/target/**\\\": true,\\n    \\\"**/.anchor/**\\\": true,\\n    \\\"**/test-ledger/**\\\": true,\\n    \\\"**/.solana-config/keys/**\\\": true\\n  },\\n  // general config\\n  \\\"rust-analyzer.restartServerOnConfigChange\\\": true,\\n  \\\"rust-analyzer.checkOnSave\\\": true,\\n  \\\"rust-analyzer.check.command\\\": \\\"check\\\", // clippy is more thorough BUT more resource intensive; `check` is faster BUT less thorough\\n  \\\"rust-analyzer.check.workspace\\\": true,\\n  \\\"rust-analyzer.check.allTargets\\\": true,\\n  // RUST PERFORMANCE SETTINGS\\n  \\\"rust-analyzer.cachePriming.enable\\\": true,\\n  \\\"rust-analyzer.cachePriming.numThreads\\\": \\\"physical\\\", // 6-8 = smooth startup | 10 = opt. for 14c M4 Max | 12 = faster warmup but more CPU burst | 14 = near max for likely 14-core M4 Max | 16 = only for 16c M4 Max\\n  \\\"rust-analyzer.numThreads\\\": null, // 8-10 = smooth/editor-first | 10 = opt. for 14c M4 Max | 12 = aggressive | 14+ = excessive\\n  \\\"rust-analyzer.procMacro.processes\\\": 4, // 2-3 = smooth/editor-first | 4 = opt. for 14c M4 Max | 5-6 = aggressive, useful if Anchor macro expansion is the bottleneck | 8+ = excessive\\n  \\\"rust-analyzer.lru.capacity\\\": 1024, // 256  = conservative | 512  = good general-purpose setting | 1024 = opt. for 14c M4 Max | 2048 = aggressive, useful for large Rust workspaces | 4096 = excessive\\n  \\\"rust-analyzer.procMacro.enable\\\": true,\\n  \\\"rust-analyzer.procMacro.attributes.enable\\\": true,\\n  \\\"rust-analyzer.cargo.allTargets\\\": true,\\n  \\\"rust-analyzer.cargo.targetDir\\\": true,\\n  \\\"rust-analyzer.cargo.buildScripts.enable\\\": true,\\n  \\\"rust-analyzer.cargo.buildScripts.rebuildOnSave\\\": true,\\n  \\\"rust-analyzer.cargo.buildScripts.useRustcWrapper\\\": true,\\n\\n  // LAND: BASH-LIKE\\n  \\\"[shellscript]\\\": {\\n    // \\\"editor.defaultFormatter\\\": \\\"foxundermoon.shell-format\\\",\\n    \\\"editor.defaultFormatter\\\": \\\"mkhl.shfmt\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"shellformat.flag\\\": \\\"-ci -i 2\\\",\\n  \\\"shellformat.effectLanguages\\\": [\\n    \\\"azcli\\\",\\n    \\\"dockerfile\\\",\\n    \\\"dotenv\\\",\\n    \\\"env\\\",\\n    \\\"gitignore\\\",\\n    \\\"hosts\\\",\\n    \\\"ignore\\\",\\n    \\\"jvmoptions\\\",\\n    \\\"properties\\\",\\n    \\\"shellscript\\\",\\n    \\\"spring-boot-properties\\\"\\n  ],\\n  \\\"shellformat.path\\\": \\\"/Users/matthias/go/bin/shfmt\\\",\\n\\n  \\\"[snippets]\\\": {\\n    // \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[solidity]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"NomicFoundation.hardhat-solidity\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"[sql]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"mtxr.sqltools\\\"\\n  },\\n  \\\"[toml]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"tombi-toml.tombi\\\",\\n    \\\"editor.tabSize\\\": 4\\n  },\\n  \\\"tombi.env\\\": {\\n    \\\"schema.strict\\\": \\\"false\\\"\\n  },\\n  \\\"evenBetterToml.formatter.arrayTrailingComma\\\": true,\\n  \\\"evenBetterToml.formatter.arrayAutoExpand\\\": false, // addresses bug/issue ticket in 0.21.2\\n\\n  // LANG: TS/TYPESCRIPT\\n  \\\"[typescript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"js.inlayHints.enumMemberValues.enabled\\\": true, // Apparently this is the recommended replacement. Doesnt seem to exist (at least in the current version).\\n  \\\"javascript.inlayHints.enumMemberValues.enabled\\\": true, // Warning: \\\"This setting is deprecated. Use js/ts.inlayHints.enumMemberValues.enabled instead.\\\"\\n  \\\"ts.inlayHints.enumMemberValues.enabled\\\": true, // Apparently this is the recommended replacement. Doesnt seem to exist (at least in the current version).\\n  \\\"typescript.inlayHints.enumMemberValues.enabled\\\": true, // Warning: \\\"This setting is deprecated. Use js/ts.inlayHints.enumMemberValues.enabled instead.\\\"\\n  \\\"npm-intellisense.importQuotes\\\": \\\"\\\\\\\"\\\",\\n  \\\"typescript.preferences.importModuleSpecifier\\\": \\\"relative\\\",\\n  \\\"typescript.preferences.includePackageJsonAutoImports\\\": \\\"on\\\",\\n  \\\"typescript.preferences.preferTypeOnlyAutoImports\\\": true,\\n  \\\"[typescriptreact]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n\\n  \\\"[yaml]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  ///////////////////////////// LANGUAGE SETTINGS /////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ////////////////////////////////// EDITOR ///////////////////////////////////\\n  // Editor: Diff Editor\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n  // Editor: Editor\\n  \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n  \\\"editor.autoClosingBrackets\\\": \\\"beforeWhitespace\\\",\\n  \\\"editor.autoClosingDelete\\\": \\\"always\\\",\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.glyphMargin\\\": true,\\n  \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\n  \\\"editor.inlineSuggest.enabled\\\": true,\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.minimap.maxColumn\\\": 40,\\n  \\\"editor.minimap.renderCharacters\\\": false,\\n  \\\"editor.minimap.size\\\": \\\"fit\\\",\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"editor.tabCompletion\\\": \\\"on\\\",\\n  \\\"editor.tabSize\\\": 2,\\n  \\\"editor.wordWrapColumn\\\": 100,\\n  \\\"editor.semanticHighlighting.enabled\\\": true,\\n  // Editor: Files\\n  \\\"files.associations\\\": {\\n    ////////////////////\\n    // (below) Git Files\\n    \\\"exclude\\\": \\\"ignore\\\",\\n    \\\".gitignore\\\": \\\"ignore\\\",\\n    \\\"pre-push\\\": \\\"shellscript\\\",\\n    \\\"prepare-commit-msg\\\": \\\"shellscript\\\",\\n    \\\"commit-msg\\\": \\\"shellscript\\\",\\n    \\\"pre-commit\\\": \\\"shellscript\\\",\\n    \\\"post-commit\\\": \\\"shellscript\\\",\\n    \\\"applypatch-msg\\\": \\\"shellscript\\\",\\n    \\\"pre-applypatch\\\": \\\"shellscript\\\",\\n    \\\"post-applypatch\\\": \\\"shellscript\\\",\\n    \\\"pre-rebase\\\": \\\"shellscript\\\",\\n    \\\"post-rewrite\\\": \\\"shellscript\\\",\\n    \\\"post-checkout\\\": \\\"shellscript\\\",\\n    \\\"post-merge\\\": \\\"shellscript\\\",\\n    \\\"pre-merge-commit\\\": \\\"shellscript\\\",\\n    \\\"pre-receive\\\": \\\"shellscript\\\",\\n    \\\"post-receive\\\": \\\"shellscript\\\",\\n    \\\"proc-receive\\\": \\\"shellscript\\\",\\n    \\\"sendemail-validate\\\": \\\"shellscript\\\",\\n    \\\"update\\\": \\\"shellscript\\\",\\n    \\\"post-update\\\": \\\"shellscript\\\",\\n    \\\"pre-auto-gc\\\": \\\"shellscript\\\",\\n    \\\"push-to-checkout\\\": \\\"shellscript\\\",\\n    \\\"reference-transaction\\\": \\\"shellscript\\\",\\n    \\\"fsmonitor-watchman\\\": \\\"shellscript\\\",\\n    // (above) Git Files\\n    ////////////////////\\n    \\\"*.env\\\": \\\"shellscript\\\",\\n    \\\"*.zshrc\\\": \\\"shellscript\\\",\\n    \\\"*.zsh\\\": \\\"shellscript\\\",\\n    \\\"*.sh\\\": \\\"shellscript\\\",\\n    \\\"*.bash\\\": \\\"shellscript\\\",\\n    \\\"*.rest\\\": \\\"http\\\",\\n    \\\"*.yaml-tmLanguage\\\": \\\"yaml\\\",\\n    \\\"*.mmd\\\": \\\"mermaid\\\",\\n    \\\"*.mermaid\\\": \\\"mermaid\\\",\\n    \\\"*.ps1\\\": \\\"powershell\\\",\\n    \\\"*.mhtml\\\": \\\"html\\\",\\n    \\\".npmignore\\\": \\\"ignore\\\",\\n    \\\".prettierignore\\\": \\\"ignore\\\",\\n    \\\".eslintignore\\\": \\\"ignore\\\",\\n    \\\".rgignore\\\": \\\"ignore\\\",\\n    \\\".claudeignore\\\": \\\"ignore\\\",\\n    \\\".excalidraw\\\": \\\"jsonc\\\",\\n    \\\".consolidate-repo.include\\\": \\\"ignore\\\",\\n    \\\".consolidate-repo.exclude\\\": \\\"ignore\\\",\\n    \\\".consolidate-repo.patterns\\\": \\\"toml\\\"\\n  },\\n  // Editor: Search\\n  \\\"search.exclude\\\": {\\n    \\\"**/*.cpy\\\": true,\\n    \\\"**/*.pyc\\\": true,\\n    \\\"**/*tsconfig.tsbuildinfo\\\": true,\\n    \\\"**/build\\\": true,\\n    \\\"**/bun.lockb\\\": true,\\n    \\\"**/dist\\\": true,\\n    \\\"**/node_modules\\\": true,\\n    \\\"**/out\\\": true,\\n    \\\"**/package-lock.json\\\": true,\\n    \\\"**/yarn.lock\\\": true\\n  },\\n  // Editor: Window\\n  \\\"window.commandCenter\\\": false,\\n  \\\"window.zoomLevel\\\": -1,\\n  \\\"window.autoDetectColorScheme\\\": true,\\n  // Editor: Updates\\n  \\\"update.mode\\\": \\\"manual\\\",\\n  // Editor: Performance\\n  \\\"keyboard.touchbar.enabled\\\": false,\\n  \\\"terminal.integrated.gpuAcceleration\\\": \\\"on\\\",\\n  // Editor Layout: General\\n  \\\"workbench.activityBar.location\\\": \\\"top\\\",\\n  \\\"workbench.layoutControl.enabled\\\": false,\\n  \\\"workbench.welcomePage.extraAnnouncements\\\": false,\\n  \\\"workbench.tips.enabled\\\": false,\\n  \\\"workbench.colorTheme\\\": \\\"Dark Modern\\\",\\n  \\\"workbench.preferredDarkColorTheme\\\": \\\"Dark Modern\\\",\\n  // Editor Layout: Gutter\\n  \\\"scm.diffDecorationsGutterWidth\\\": 5,\\n  \\\"scm.showIncomingChanges\\\": \\\"never\\\", // @todo please add annotation - unsure what this does\\n  \\\"scm.showOutgoingChanges\\\": \\\"never\\\", // @todo please add annotation - unsure what this does\\n  ////////////////////////////////// EDITOR ///////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  //////////////////////////////////// GIT ////////////////////////////////////\\n  \\\"git.alwaysSignOff\\\": true,\\n  \\\"git.enableCommitSigning\\\": true,\\n  \\\"git.openRepositoryInParentFolders\\\": \\\"always\\\",\\n  \\\"git.suggestSmartCommit\\\": false,\\n  \\\"git.addAICoAuthor\\\": \\\"off\\\",\\n  \\\"git.enableSmartCommit\\\": false,\\n  \\\"git.defaultBranchName\\\": \\\"main\\\",\\n  \\\"chat.mcp.gallery.enabled\\\": false,\\n  // \\\"Gitlens\\\" Extendsion\\n  \\\"gitlens.views.branches.branches.layout\\\": \\\"list\\\",\\n  \\\"gitlens.views.commits.pullRequests.enabled\\\": false,\\n  \\\"gitlens.views.formats.stashes.description\\\": \\\"${stashOnRef, } ${message} - ${authorDate} - ${tips}\\\",\\n  \\\"gitlens.views.formats.stashes.label\\\": \\\"${message} ${authorDate}\\\",\\n  \\\"gitlens.views.commits.files.layout\\\": \\\"list\\\",\\n  \\\"gitlens.views.scm.grouped.views\\\": {\\n    \\\"commits\\\": false,\\n    \\\"branches\\\": false,\\n    \\\"remotes\\\": false,\\n    \\\"stashes\\\": false,\\n    \\\"tags\\\": false,\\n    \\\"worktrees\\\": false,\\n    \\\"contributors\\\": false,\\n    \\\"repositories\\\": false,\\n    \\\"searchAndCompare\\\": false,\\n    \\\"launchpad\\\": false\\n  },\\n  \\\"gitlens.ai.openInAgent\\\": \\\"manual\\\",\\n  // \\\"gitlens.ai.gitkraken.model\\\": null,\\n  // \\\"gitlens.ai.openaicompatible.url\\\": null,\\n  // \\\"gitlens.ai.modelOptions.temperature\\\": 0.7,\\n  // \\\"gitlens.ai.largePromptWarningThreshold\\\": 120000,\\n  // \\\"gitlens.ai.reviewChanges.customInstructions\\\": null,\\n  // \\\"gitlens.ai.explainChanges.customInstructions\\\": null,\\n  // \\\"gitlens.ai.generateCommits.customInstructions\\\": null,\\n  // \\\"gitlens.ai.generateChangelog.customInstructions\\\": null,\\n  // \\\"gitlens.ai.generateCommitMessage.customInstructions\\\": null,\\n  // \\\"gitlens.ai.generateCreateCloudPatch.customInstructions\\\": null,\\n  // \\\"gitlens.ai.generateCreateCodeSuggest.customInstructions\\\": null,\\n  // \\\"gitlens.ai.generateCreatePullRequest.customInstructions\\\": null,\\n  // \\\"gitlens.ai.generateStashMessage.customInstructions\\\": null,\\n  \\\"gitlens.gitkraken.cli.insiders.enabled\\\": null, // testing - 09/02/2026\\n  \\\"gitlens.advanced.git.maxConcurrentProcesses\\\": 10, // testing - 09/02/2026\\n  // \\\"gitlens.ai.ollama.url\\\": null,\\n  // \\\"gitlens.ai.model\\\": null,\\n  // \\\"gitlens.ai.enabled\\\": true,\\n  // \\\"gitlens.ai.azure.url\\\": null,\\n  // \\\"gitlens.ai.openai.url\\\": null,\\n  // \\\"gitlens.ai.defaultAgent\\\": null,\\n  // \\\"gitlens.ai.vscode.model\\\": null,\\n  \\\"gitlens.ai.exclude.files\\\": {\\n    \\\"**/pnpm-lock.yaml\\\": true,\\n    \\\"**/package-lock.json\\\": true,\\n    \\\"**/yarn.lock\\\": true,\\n    \\\"**/Cargo.lock\\\": true,\\n    \\\"**/Gemfile.lock\\\": true,\\n    \\\"**/composer.lock\\\": true,\\n    \\\"**/Pipfile.lock\\\": true,\\n    \\\"**/poetry.lock\\\": true,\\n    \\\"**/go.sum\\\": true,\\n    \\\"**/*.min.js\\\": true,\\n    \\\"**/*.min.css\\\": true,\\n    \\\"**/*.map\\\": true,\\n    \\\"**/dist/**\\\": true,\\n    \\\"**/out/**\\\": true,\\n    \\\"**/build/**\\\": true,\\n    \\\"**/node_modules/**\\\": true,\\n    \\\"**/.hidden\\\": true,\\n    \\\"**/.hidden/*\\\": true,\\n    \\\"**/.hidden/**\\\": true,\\n    \\\"**/.hidden.*\\\": true,\\n    \\\"**/*.hidden.*\\\": true,\\n    \\\"**/*.hidden\\\": true\\n  },\\n  \\\"gitlens.visualHistory.allowMultiple\\\": true, // testing - 09/02/2026\\n  // \\\"gitlens.views.formats.commits.description\\\": \\\"${author, }${agoOrDate}\\\", // testing - 09/02/2026\\n  // \\\"gitlens.views.formats.commits.label\\\": \\\"${❰ tips|11? ❱➤  }${message}\\\",\\n  // \\\"gitlens.views.formats.commits.tooltip\\\": \\\"${avatar} &nbsp;__${author}__${signature} &nbsp;$(history) ${agoAndDateBothSources} \\\\\\\\\\\\n${link}${' via  'pullRequest}${'&nbsp;&nbsp;'changesDetail} ${message}${\\\\n\\\\n---\\\\n\\\\nfootnotes}\\\\n\\\\n${tips}\\\",\\n  // \\\"gitlens.views.formats.commits.tooltipWithStatus\\\": \\\"${avatar} &nbsp;__${author}__${signature} &nbsp;$(history) ${agoAndDateBothSources} \\\\\\\\\\\\n${link}${' via  'pullRequest}&nbsp;&nbsp;•&nbsp;&nbsp;{{slot-status}} ${message}${\\\\n\\\\n---\\\\n\\\\nfootnotes}\\\\n\\\\n${tips}\\\",\\n  //////////////////////////////////// GIT ////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ////////////////////////////////// GITHUB ///////////////////////////////////\\n  \\\"chat.autopilot.enabled\\\": false,\\n  // \\\"GitHub CoPilot\\\" Extension\\n  \\\"github.copilot.enable\\\": {\\n    \\\"*\\\": true,\\n    \\\"plaintext\\\": false,\\n    \\\"markdown\\\": false,\\n    \\\"scminput\\\": false\\n  },\\n  \\\"github.copilot.advanced\\\": {}, // Apparently this is how to disable copilot\\n  // \\\"GitHub Pull-Requests\\\" Extension\\n  \\\"githubPullRequests.defaultMergeMethod\\\": \\\"squash\\\",\\n  \\\"githubPullRequests.showPullRequestNumberInTree\\\": true,\\n  \\\"githubPullRequests.pullBranch\\\": \\\"never\\\",\\n  \\\"githubPullRequests.remotes\\\": [\\\"origin\\\"],\\n  \\\"githubPullRequests.assignCreated\\\": \\\"${user}\\\",\\n  \\\"githubPullRequests.pushBranch\\\": \\\"always\\\",\\n  \\\"githubPullRequests.quickDiff\\\": true,\\n  // \\\"GitHub Issues\\\" Extension\\n  \\\"githubIssues.queries\\\": [\\n    {\\n      \\\"label\\\": \\\"My Issues\\\",\\n      \\\"query\\\": \\\"author:${user} state:open repo:${owner}/${repository} sort:created-desc\\\"\\n    },\\n    {\\n      \\\"label\\\": \\\"Recent Issues\\\",\\n      \\\"query\\\": \\\"state:open repo:${owner}/${repository} sort:updated-desc\\\"\\n    }\\n  ],\\n  \\\"githubIssues.createInsertFormat\\\": \\\"url\\\",\\n  \\\"githubIssues.issueBranchTitle\\\": \\\"${issueNumber}-${sanitizedIssueTitle}\\\",\\n  \\\"githubIssues.createIssueTriggers\\\": [\\\"TODO\\\", \\\"todo\\\", \\\"BUG\\\", \\\"FIXME\\\", \\\"ISSUE\\\", \\\"@todo\\\"],\\n  ////////////////////////////////// GITHUB ///////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////// DOCKER/KUBERNETES /////////////////////////////\\n  \\\"vs-kubernetes\\\": {\\n    \\\"vscode-kubernetes.helm-path-mac\\\": \\\"/Users/matthias/.vs-kubernetes/tools/helm/darwin-amd64/helm\\\",\\n    \\\"vscode-kubernetes.minikube-path-mac\\\": \\\"/Users/matthias/.vs-kubernetes/tools/minikube/darwin-amd64/minikube\\\"\\n  },\\n  ///////////////////////////// DOCKER/KUBERNETES /////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////////// TELEMETRY /////////////////////////////////\\n  \\\"dotnetAcquisitionExtension.enableTelemetry\\\": false,\\n  \\\"extensions.autoCheckUpdates\\\": false,\\n  \\\"extensions.autoUpdate\\\": false,\\n  \\\"extensions.webWorker\\\": false,\\n  \\\"gitlens.telemetry.enabled\\\": false,\\n  \\\"hardhat.telemetry\\\": false,\\n  \\\"js.suggestionActions.enabled\\\": false,\\n  \\\"javascript.suggestionActions.enabled\\\": false, // Warning: \\\"This setting is deprecated. Use js/ts.suggestionActions.enabled instead.\\\"; Description: \\\"Enable/disable suggestion diagnostics for JavaScript files in the editor.\\\"\\n  // \\\"javascript.suggestionActions.enabled\\\": false,\\n  \\\"php.suggest.basic\\\": false,\\n  \\\"redhat.telemetry.enabled\\\": false,\\n  \\\"rest-client.enableTelemetry\\\": false,\\n  \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n  \\\"solidity.telemetry\\\": false,\\n  \\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\n  \\\"typescript.suggestionActions.enabled\\\": false, // Warning: \\\"This setting is deprecated. Use js/ts.suggestionActions.enabled instead.\\\"; Description: \\\"Enable/disable suggestion diagnostics for TypeScript files in the editor.\\\"\\n  \\\"ts.suggestionActions.enabled\\\": false,\\n  \\\"typescript.surveys.enabled\\\": false,\\n  \\\"workbench.enableExperiments\\\": false,\\n  \\\"workbench.settings.enableNaturalLanguageSearch\\\": false,\\n  \\\"telemetry.feedback.enabled\\\": false,\\n  \\\"network.meteredConnection\\\": \\\"on\\\",\\n  ///////////////////////////////// TELEMETRY /////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  //////////////////////////////////// EVM ////////////////////////////////////\\n  //////////////////////////////////// EVM ////////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////////// VIM/NEOVIM ////////////////////////////////\\n  \\\"extensions.experimental.affinity\\\": {\\n    \\\"asvetliakov.vscode-neovim\\\": 1\\n  },\\n  ///////////////////////////////// VIM/NEOVIM ////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////////// BOOKMARKS /////////////////////////////////\\n  \\\"todohighlight.include\\\": [\\n    \\\"**/*.ts\\\",\\n    \\\"**/*.tsx\\\",\\n    \\\"**/*.md\\\",\\n    \\\"**/*.rs\\\",\\n    \\\"**/*.mmd\\\",\\n    \\\"**/*.mermaid\\\",\\n    \\\"**/*.js\\\",\\n    \\\"**/*.jsx\\\",\\n    \\\"**/*.json\\\",\\n    \\\"**/*.py\\\",\\n    \\\"**/*.ipynb\\\"\\n  ],\\n  \\\"inline-bookmarks.default.words.red\\\": \\\"@fix[\\\\\\\\s],@delete[\\\\\\\\s]\\\",\\n  \\\"inline-bookmarks.default.words.blue\\\": \\\"@note[\\\\\\\\s]\\\",\\n  \\\"inline-bookmarks.default.words.purple\\\": \\\"@todo[\\\\\\\\s]\\\",\\n  \\\"inline-bookmarks.default.words.green\\\": \\\"\\\",\\n  \\\"inline-bookmarks.search.excludes\\\": [\\n    \\\"**/_output/**\\\",\\n    \\\"**/.git/**\\\",\\n    \\\"**/.github/**\\\",\\n    \\\"**/.next/**\\\",\\n    \\\"**/.vscode-test/**\\\",\\n    \\\"**/.vscode/**\\\",\\n    \\\"**/*.map\\\",\\n    \\\"**/*.min.*\\\",\\n    \\\"**/bower_components/**\\\",\\n    \\\"**/build/**\\\",\\n    \\\"**/dist\\\",\\n    \\\"**/node_modules/**\\\",\\n    \\\"**/out/**\\\"\\n  ],\\n  ///////////////////////////////// BOOKMARKS /////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ///////////////////////////////// PRETTIER //////////////////////////////////\\n  \\\"prettier.printWidth\\\": 100,\\n  \\\"prettier.htmlWhitespaceSensitivity\\\": \\\"strict\\\",\\n  ///////////////////////////////// PRETTIER //////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  //////////////////////////// OPENAI/CHATGPT/CODEX ///////////////////////////\\n  \\\"chatgpt.composerEnterBehavior\\\": \\\"cmdIfMultiline\\\",\\n  \\\"chatgpt.localeOverride\\\": \\\"english\\\",\\n  \\\"chatgpt.followUpQueueMode\\\": \\\"queue\\\",\\n  \\\"chatgpt.openOnStartup\\\": false,\\n\\n  //**//**//**// NEED TO RESEARCH, REVIEW, AND DECIDE ON HOW TO SET THE FOLLOWING PROPERTIES **//**//**//\\n  \\\"chatgpt.reviewDelivery\\\": \\\"detached\\\", // testing\\n  // \\\"gitlens.ai.openai.url\\\": null,\\n  // \\\"gitlens.ai.openaicompatible.url\\\": null,\\n  // \\\"chatgpt.commentCodeLensEnabled\\\": true,\\n  // \\\"chatgpt.runCodexInWindowsSubsystemForLinux\\\": false,\\n  // \\\"[codex-rules]\\\": {},\\n  //////////////////////////// OPENAI/CHATGPT/CODEX ///////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n\\n  /////////////////////////////////////////////////////////////////////////////\\n  ////////////////////////////////// CLAUDE ///////////////////////////////////\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n  \\\"claudeCode.respectGitIgnore\\\": true,\\n  \\\"claudeCode.hideOnboarding\\\": true,\\n  \\\"claudeCode.autosave\\\": false,\\n  \\\"claudeCode.useCtrlEnterToSend\\\": true,\\n  \\\"nifty.shell-format.switchCaseIndent\\\": true\\n\\n  //**//**//**// NEED TO RESEARCH, REVIEW, AND DECIDE ON HOW TO SET THE FOLLOWING PROPERTIES **//**//**//\\n  // \\\"claudeCode.claudeProcessWrapper\\\": \\\"/Users/matthias/.local/bin/claude\\\",\\n  // \\\"claudeCode.useTerminal\\\": false,\\n  // \\\"claudeCode.usePythonEnvironment\\\": true,\\n  // \\\"claudeCode.environmentVariables\\\": [],\\n  // \\\"claudeCode.enableReopenClosedSessionShortcut\\\": false,\\n  // \\\"claudeCode.enableNewConversationShortcut\\\": false,\\n  // \\\"claudeCode.disableLoginPrompt\\\": false,\\n  ////////////////////////////////// CLAUDE ///////////////////////////////////\\n  /////////////////////////////////////////////////////////////////////////////\\n}\\n\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaultsauto[]\\n[\\n  {\\n    \\\"key\\\": \\\"shift+alt+4\\\",\\n    \\\"command\\\": \\\"issue.startWorkingBranchDescriptiveTitle\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+2\\\",\\n    \\\"command\\\": \\\"issue.createIssue\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+3\\\",\\n    \\\"command\\\": \\\"pr.pushAndCreate\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+z\\\",\\n    \\\"command\\\": \\\"issues:github.focus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+1\\\",\\n    \\\"command\\\": \\\"issue.createIssueFromSelection\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+w\\\",\\n    \\\"command\\\": \\\"git.checkout\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+e\\\",\\n    \\\"command\\\": \\\"git.fetch\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+c\\\",\\n    \\\"command\\\": \\\"issue.statusBar\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+x\\\",\\n    \\\"command\\\": \\\"pr.refreshChanges\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+x\\\",\\n    \\\"command\\\": \\\"issue.refresh\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+m\\\",\\n    \\\"command\\\": \\\"pr.merge\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+\\\\\\\\\\\",\\n    \\\"command\\\": \\\"editor.action.selectToBracket\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+/\\\",\\n    \\\"command\\\": \\\"editor.action.goToImplementation\\\",\\n    \\\"when\\\": \\\"editorHasImplementationProvider && editorTextFocus && !isInEmbeddedEditor\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"search.action.cancel\\\",\\n    \\\"when\\\": \\\" searchViewletVisible && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"search.action.cancel\\\",\\n    \\\"when\\\": \\\"listFocus && searchViewletVisible && !inputFocus && searchState != '0'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"closeReferenceSearch\\\",\\n    \\\"when\\\": \\\"inReferenceSearchEditor && !config.editor.stablePeek\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"closeReferenceSearch\\\",\\n    \\\"when\\\": \\\"referenceSearchVisible && !config.editor.stablePeek\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"search.action.cancel\\\",\\n    \\\"when\\\": \\\"listFocus && searchViewletVisible && !inputFocus && searchState != '0'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"removeSecondaryCursors\\\",\\n    \\\"when\\\": \\\"editorHasMultipleSelections && textInputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+l\\\",\\n    \\\"command\\\": \\\"closeFindWidget\\\",\\n    \\\"when\\\": \\\"editorFocus && findWidgetVisible && !isComposing\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+=\\\",\\n    \\\"command\\\": \\\"-workbench.action.zoomIn\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+=\\\",\\n    \\\"command\\\": \\\"workbench.action.debug.stepOver\\\",\\n    \\\"when\\\": \\\"debugState == 'stopped'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"f10\\\",\\n    \\\"command\\\": \\\"-workbench.action.debug.stepOver\\\",\\n    \\\"when\\\": \\\"debugState == 'stopped'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+0\\\",\\n    \\\"command\\\": \\\"editor.debug.action.toggleBreakpoint\\\",\\n    \\\"when\\\": \\\"debuggersAvailable && disassemblyViewFocus || debuggersAvailable && editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+cmd+=\\\",\\n    \\\"command\\\": \\\"workbench.action.debug.stepInto\\\",\\n    \\\"when\\\": \\\"debugState != 'inactive'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+cmd+-\\\",\\n    \\\"command\\\": \\\"workbench.action.debug.stepOut\\\",\\n    \\\"when\\\": \\\"debugState == 'stopped'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"-workbench.view.debug\\\",\\n    \\\"when\\\": \\\"viewContainer.workbench.view.debug.enabled\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"workbench.view.scm\\\",\\n    \\\"when\\\": \\\"workbench.scm.active && !gitlens:disabled && config.gitlens.keymap == 'chorded'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+d\\\",\\n    \\\"command\\\": \\\"workbench.view.scm\\\",\\n    \\\"when\\\": \\\"workbench.scm.active\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+h\\\",\\n    \\\"command\\\": \\\"gitlens.views.fileHistory.focus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+c\\\",\\n    \\\"command\\\": \\\"-editor.action.addCommentLine\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+c\\\",\\n    \\\"command\\\": \\\"-notebook.cell.collapseCellInput\\\",\\n    \\\"when\\\": \\\"notebookCellListFocused && !inputFocus && !notebookCellInputIsCollapsed\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+c\\\",\\n    \\\"command\\\": \\\"-notebook.cell.expandCellInput\\\",\\n    \\\"when\\\": \\\"notebookCellInputIsCollapsed && notebookCellListFocused\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+c\\\",\\n    \\\"command\\\": \\\"copyRelativeFilePath\\\",\\n    \\\"when\\\": \\\"editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k shift+alt+cmd+c\\\",\\n    \\\"command\\\": \\\"-copyRelativeFilePath\\\",\\n    \\\"when\\\": \\\"editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k cmd+c\\\",\\n    \\\"command\\\": \\\"copyRelativeFilePath\\\",\\n    \\\"when\\\": \\\"!editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+cmd+c\\\",\\n    \\\"command\\\": \\\"-copyRelativeFilePath\\\",\\n    \\\"when\\\": \\\"!editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k alt+cmd+c\\\",\\n    \\\"command\\\": \\\"-workbench.action.addComment\\\",\\n    \\\"when\\\": \\\"activeCursorHasCommentingRange\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+k alt+cmd+c\\\",\\n    \\\"command\\\": \\\"copyFilePath\\\",\\n    \\\"when\\\": \\\"!editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+c\\\",\\n    \\\"command\\\": \\\"-copyFilePath\\\",\\n    \\\"when\\\": \\\"!editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+w\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.kill\\\",\\n    \\\"when\\\": \\\"terminal.visible && terminalFocus && terminalViewShowing\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+\\\\\\\\\\\",\\n    \\\"command\\\": \\\"-workbench.action.terminal.split\\\",\\n    \\\"when\\\": \\\"terminalFocus && terminalProcessSupported || terminalFocus && terminalWebExtensionContributedProfile\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+n\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.split\\\",\\n    \\\"when\\\": \\\"terminalFocus && terminalProcessSupported || terminalFocus && terminalWebExtensionContributedProfile\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+5\\\",\\n    \\\"command\\\": \\\"-workbench.action.terminal.split\\\",\\n    \\\"when\\\": \\\"terminalFocus && terminalProcessSupported || terminalFocus && terminalWebExtensionContributedProfile\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+cmd+w\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.toggleFindWholeWord\\\",\\n    \\\"when\\\": \\\"terminalFindVisible && terminalHasBeenCreated || terminalFindVisible && terminalProcessSupported\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+w\\\",\\n    \\\"command\\\": \\\"-workbench.action.terminal.toggleFindWholeWord\\\",\\n    \\\"when\\\": \\\"terminalFindVisible && terminalHasBeenCreated || terminalFindVisible && terminalProcessSupported\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+cmd+w\\\",\\n    \\\"command\\\": \\\"toggleFindWholeWord\\\",\\n    \\\"when\\\": \\\"editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+w\\\",\\n    \\\"command\\\": \\\"-toggleFindWholeWord\\\",\\n    \\\"when\\\": \\\"editorFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+cmd+w\\\",\\n    \\\"command\\\": \\\"toggleSearchEditorWholeWord\\\",\\n    \\\"when\\\": \\\"inSearchEditor && searchInputBoxFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+w\\\",\\n    \\\"command\\\": \\\"-toggleSearchEditorWholeWord\\\",\\n    \\\"when\\\": \\\"inSearchEditor && searchInputBoxFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+cmd+w\\\",\\n    \\\"command\\\": \\\"toggleSearchWholeWord\\\",\\n    \\\"when\\\": \\\"searchViewletFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+w\\\",\\n    \\\"command\\\": \\\"-toggleSearchWholeWord\\\",\\n    \\\"when\\\": \\\"searchViewletFocus\\\"\\n  }\\n]\",\"platform\":1}","snippets":"{\"snippets\":{\"csharp.json\":\"// snippet-generator.app\\n{\\n\\t// Place your snippets for csharp here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"Interpolated Multiline Console Log\\\": {\\n\\t\\t\\\"prefix\\\": \\\"llog\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"Console.WriteLine(@$\\\\\\\"$1\\\\\\\");\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Interpolated Multiline Console Log\\\"\\n\\t},\\n\\t\\\"Interpolated Multiline Console Log With JSON\\\": {\\n\\t\\t\\\"prefix\\\": \\\"lljson\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"Console.WriteLine(@$\\\\\\\"{JsonConvert.SerializeObject($1, Formatting.Indented)}\\\\\\\");\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Interpolated Multiline Console Log With JSON\\\"\\n\\t}\\n}\",\"rust.json\":\"{\\n  ///////////////////////////////////////////////////\\n  ///////////////////// PRINT ///////////////////////\\n  \\\"Simple string print statement\\\": {\\n    \\\"prefix\\\": \\\"pls\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1\\\\\\\");\\\", \\\"$0\\\"],\\n    \\\"description\\\": \\\"Common print statement without input\\\"\\n  },\\n  \\\"Print statement w/ primative input\\\": {\\n    \\\"prefix\\\": \\\"plp\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{}$2\\\\\\\", $3);$0\\\"],\\n    \\\"description\\\": \\\"Basic print statement with input\\\"\\n  },\\n  \\\"Print interpolated w/ primative input\\\": {\\n    \\\"prefix\\\": \\\"pli\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{$2}$3\\\\\\\");$0\\\"],\\n    \\\"description\\\": \\\"Interpolated print statement with input\\\"\\n  },\\n  \\\"Print statement w/ non-primative input\\\": {\\n    \\\"prefix\\\": \\\"plo\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{:?}$2\\\\\\\", $3);$0\\\"],\\n    \\\"description\\\": \\\"Basic print statement with non-primative input\\\"\\n  },\\n  \\\"Print interpolated w/ non-primative input\\\": {\\n    \\\"prefix\\\": \\\"ploi\\\",\\n    \\\"body\\\": [\\\"println!(\\\\\\\"$1{$2:?}$3\\\\\\\");$0\\\"],\\n    \\\"description\\\": \\\"Interpolated print statement with non-primative input\\\"\\n  },\\n  ///////////////////// PRINT ///////////////////////\\n  ///////////////////////////////////////////////////\\n\\n  ///////////////////////////////////////////////////\\n  ////////////////////// LET ////////////////////////\\n  \\\"Let statement\\\": {\\n    \\\"prefix\\\": \\\"llet\\\",\\n    \\\"body\\\": [\\\"let ${2:xyz}$3 = $1;$0\\\"],\\n    \\\"description\\\": \\\"Let statement\\\"\\n  },\\n  ////////////////////// LET ////////////////////////\\n  ///////////////////////////////////////////////////\\n\\n  ///////////////////////////////////////////////////\\n  //////////////////// STRINGS //////////////////////\\n  \\\"`New` string\\\": {\\n    \\\"prefix\\\": \\\"sstrnew\\\",\\n    \\\"body\\\": [\\\"let $2 = String::new();\\\", \\\"$0\\\"],\\n    \\\"description\\\": \\\"`New` string\\\"\\n  },\\n  \\\"`From` string\\\": {\\n    \\\"prefix\\\": \\\"sstrfrom\\\",\\n    \\\"body\\\": [\\\"let $2 = String::from(\\\\\\\"$1\\\\\\\");$0\\\"],\\n    \\\"description\\\": \\\"`From` string\\\"\\n  },\\n  \\\"R-string\\\": {\\n    \\\"prefix\\\": \\\"rstr\\\",\\n    \\\"body\\\": [\\\"let ${1:var_name} = r#\\\\\\\"\\\", \\\"    $2\\\", \\\"\\\\\\\"#;\\\", \\\"$0\\\"],\\n    \\\"description\\\": \\\"R-string\\\"\\n  },\\n  //////////////////// STRINGS //////////////////////\\n  ///////////////////////////////////////////////////\\n\\n  ////////////////////////////////////////////////////\\n  ////////////////////// STRUCT //////////////////////\\n  \\\"Struct with `new`\\\": {\\n    \\\"prefix\\\": \\\"structnew\\\",\\n    \\\"body\\\": [\\n      \\\"struct ${1:struct_name} {$2}\\\",\\n      \\\"\\\",\\n      \\\"impl ${1:struct_name} {\\\",\\n      \\\"    fn new(&self) -> Self {\\\",\\n      \\\"        Self {$3}\\\",\\n      \\\"    }\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Struct with `new`\\\"\\n  },\\n  ////////////////////// STRUCT //////////////////////\\n  ////////////////////////////////////////////////////\\n\\n  ///////////////////////////////////////////////////\\n  /////////////////// FUNCTIONS /////////////////////\\n  \\\"Fxn statement\\\": {\\n    \\\"prefix\\\": \\\"fxn\\\",\\n    \\\"body\\\": [\\\"fn $1($2) {$3}\\\"],\\n    \\\"description\\\": \\\"Fxn statement\\\"\\n  },\\n  \\\"Fxn statement w/ return type\\\": {\\n    \\\"prefix\\\": \\\"fxnr\\\",\\n    \\\"body\\\": [\\\"fn $1($2) -> ${3:()} {$4}\\\"],\\n    \\\"description\\\": \\\"Fxn statement w/ return type\\\"\\n  }\\n  /////////////////// FUNCTIONS /////////////////////\\n  ///////////////////////////////////////////////////\\n}\\n\",\"solidity.json\":\"{\\n  \\\"Generic Function\\\": {\\n    \\\"prefix\\\": \\\"fn\\\",\\n    \\\"body\\\": [\\\"function $1($2) $3 {$4}$0\\\"],\\n    \\\"description\\\": \\\"Generic Function\\\"\\n  },\\n  \\\"Public Function\\\": {\\n    \\\"prefix\\\": \\\"fnpub\\\",\\n    \\\"body\\\": [\\\"function $1($2) public $3 {$4}$0\\\"],\\n    \\\"description\\\": \\\"Pu